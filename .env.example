# Database (read-only MongoDB user)
MONGO_URI=mongodb+srv://admin_readonly:PASSWORD@cluster0.xxxxx.mongodb.net/test?retryWrites=true&w=majority

# Admin auth
ADMIN_EMAIL=your-personal-email@example.com
ADMIN_PASSWORD_HASH=$2b$10$REPLACE_WITH_REAL_HASH
ADMIN_TOTP_SECRET=YOUR_32_CHAR_TOTP_SECRET
ADMIN_JWT_SECRET=YOUR_128_CHAR_HEX

# Server
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=*
